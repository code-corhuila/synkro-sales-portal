# Development/build: federation entry exposing shell/apiClient and shell/session.
VITE_SHELL_ENTRY_URL=http://localhost:5173/assets/remoteEntry.js

# Container runtime: allowed host origin for remote assets (CORS).
HOST_ORIGIN=http://localhost:5173

# Issuer printed on the sale documents (PDF/XML, HU-VEN-19). Owner-confirmed public build inputs: without the
# legal name and the NIT the downloads refuse to generate. Real company data only; values that look like
# the template's examples (XXX, .example, all zeros) are rejected. Address, phone and email are optional.
VITE_ISSUER_LEGAL_NAME="synkro tech sas"
VITE_ISSUER_TAX_ID=803.256.942-7
VITE_ISSUER_ADDRESS="CRA 7 # 34-56"
# Confirmed by the owner for HU-VEN-20 (2026-11-08).
VITE_ISSUER_PHONE=3104662443
VITE_ISSUER_EMAIL=RECEPCION@SYNKROTECH.COM
# These values are compiled into the portal image: changing this file does not change documents already
# served. Rebuild the image (docker compose build) after any change.

# Preview: npm run preview uses port 5176. No API address or credentials here.

# npm/Docker standalone defaults to /. Compose defaults to the host delivery prefix.
# Set / explicitly when building a standalone container.
VITE_BASE_PATH=/remotes/sales/
